# Configuração local - funciona sem banco (modo memória) e sem GEMINI_API_KEY (modo local)
# Para usar IA completa, adicione sua chave gratuita de https://aistudio.google.com
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Para persistência em Postgres, descomente e configure:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Para Mercado Livre API oficial (opcional):
# MERCADO_LIVRE_CLIENT_ID=
# MERCADO_LIVRE_CLIENT_SECRET=
# Modelo preferido (opcional):
GEMINI_MODEL=gemini-2.0-flash
