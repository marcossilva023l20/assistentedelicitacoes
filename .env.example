# Copie para .env.local e preencha. O Next carrega .env.local automaticamente.
# .env.local está no .gitignore — nunca commite a chave.

# Obrigatório — chave gratuita em https://aistudio.google.com (API key)
GEMINI_API_KEY=

# Opcional — modelo preferido. Se indisponível, o app tenta os demais
# (gemini-3.6-flash, gemini-3.5-flash, gemini-3.8-flash, gemini-3-flash-preview).
GEMINI_MODEL=gemini-3.6-flash

# Opcional — Postgres para histórico/TR. Sem ele, o app persiste em .data/store.json
# e cria as tabelas automaticamente no primeiro uso quando DATABASE_URL existir.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Opcional — API oficial do Mercado Livre (aumenta a cobertura de ofertas)
# MERCADO_LIVRE_CLIENT_ID=
# MERCADO_LIVRE_CLIENT_SECRET=
